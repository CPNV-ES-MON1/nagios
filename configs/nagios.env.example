# =============================================================================
#  Nagios XI install — configuration template
#  Copy to nagios.env and fill in your values before running any script.
#
#  Usage:
#    cp config/nagios.env.example config/nagios.env
#    chmod 600 config/nagios.env   
#    nano config/nagios.env
#
# =============================================================================

# -----------------------------------------------------------------------------
# Web UI ports
# Nagios XI defaults to 80/443. These scripts move it to non-standard ports
# to avoid conflicts with other services on the same host.
# -----------------------------------------------------------------------------
NAGIOS_HTTP_PORT=8080
NAGIOS_HTTPS_PORT=8443

# -----------------------------------------------------------------------------
# First-run wizard (install.php) — admin account
# -----------------------------------------------------------------------------
NAGIOS_ADMIN_PASSWORD=changeme123!        # min 8 chars, set something real
NAGIOS_ADMIN_NAME=Nagios Administrator
NAGIOS_ADMIN_EMAIL=admin@yourdomain.local

# -----------------------------------------------------------------------------
# Timezone — used in the wizard and for Nagios XI internal scheduling
# Must be a valid tz database name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------------------------
NAGIOS_TIMEZONE=Europe/Zurich